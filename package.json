{
  "name": "vite-plugin-vue-layouts-next",
  "type": "module",
  "version": "3.0.0",
  "packageManager": "pnpm@12.5.1",
  "description": "Router based layout plugin for Vite 8, Vue 3 and Vue Router 5.",
  "author": "loicduong",
  "license": "MIT",
  "homepage": "https://github.com/loicduong/vite-plugin-vue-layouts-next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loicduong/vite-plugin-vue-layouts-next.git"
  },
  "bugs": "https://github.com/loicduong/vite-plugin-vue-layouts-next/issues",
  "keywords": [
    "typescript",
    "vite-plugin",
    "vite",
    "vue-router",
    "vue"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./*": "./*"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "client.d.ts",
    "dist"
  ],
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "tsdown",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "bumpp --all --commit \"release: v%s\" --tag --push --execute \"pnpm changelog\"",
    "spa:dev": "npm -C examples/spa run dev",
    "spa:build": "npm -C examples/spa run build",
    "spa:preview": "npm -C examples/spa run preview",
    "ssg:dev": "npm -C examples/ssg run dev",
    "ssg:build": "npm -C examples/ssg run build",
    "ssg:preview": "npm -C examples/ssg run preview",
    "cli:dev": "npm -C examples/client-side run dev",
    "cli:build": "npm -C examples/client-side run build",
    "cli:preview": "npm -C examples/client-side run preview",
    "ner:dev": "npm -C examples/nested-routes run dev",
    "ner:build": "npm -C examples/nested-routes run build",
    "ner:preview": "npm -C examples/nested-routes run preview",
    "docs:dev": "npm -C docs run dev",
    "docs:build": "npm -C docs run build",
    "docs:preview": "npm -C docs run preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "vue": "^3.2.4",
    "vue-router": "^4.0.11 || ^5.0.0"
  },
  "dependencies": {
    "debug": "catalog:",
    "fast-glob": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/debug": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "bumpp": "catalog:",
    "conventional-changelog-cli": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-slop": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "happy-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "volta": {
    "node": "22.23.2",
    "pnpm": "11.25.0"
  }
}
